# ============================================================
#  MoveInSync Settlement Engine — Environment Variables
#
#  Copy this file to .env and fill in your production values.
#  NEVER commit .env to version control.
#
#  Usage:
#    cp .env.example .env
#    # Edit .env with real values
#    docker compose --env-file .env up -d
#
#  Generate a secure JWT secret:
#    openssl rand -hex 32
# ============================================================

# ── Database ───────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/settlement
SPRING_DATASOURCE_USERNAME=settlement
SPRING_DATASOURCE_PASSWORD=settlement_dev

# ── JWT Authentication ─────────────────────────────────────
# Replace with a real 256-bit secret in production:
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ── Server ─────────────────────────────────────────────────
SERVER_PORT=8080
